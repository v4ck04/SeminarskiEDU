# Copy this file to .env and fill in only the services you use.
# .env is git-ignored. Keys are read from the environment and are never logged.

# Claude API - automatic script generation / visual analysis when running the CLI
# outside Claude Code (inside Claude Code, Claude writes the script itself).
ANTHROPIC_API_KEY=

# Text-to-speech (optional - Edge TTS and offline Windows voices need no key)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Licensed stock footage (optional). Free keys:
#   https://www.pexels.com/api/   https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: explicit FFmpeg location if it is not on PATH
# RCSTUDIO_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# RCSTUDIO_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
