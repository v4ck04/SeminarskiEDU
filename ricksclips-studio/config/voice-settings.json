{
  "provider": "auto",
  "provider_priority": [
    "elevenlabs",
    "openai",
    "edge",
    "pyttsx3",
    "flite"
  ],
  "pitch_semitones": 0.0,
  "trim_silence": true,
  "align_with_whisper": "auto",
  "elevenlabs": {
    "voice_id": "",
    "model_id": "eleven_multilingual_v2",
    "output_format": "mp3_44100_128",
    "stability": 0.45,
    "similarity_boost": 0.75,
    "style": 0.15,
    "use_speaker_boost": true
  },
  "openai": {
    "model": "gpt-4o-mini-tts",
    "voice": "onyx",
