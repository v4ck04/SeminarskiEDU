  },
  "edge": {
    "voice": "en-US-AndrewNeural",
    "rate": "+0%",
    "pitch": "+0Hz"
  },
  "pyttsx3": {
    "voice_name_contains": "",
    "rate_wpm": 180
  },
  "flite": {
    "voice": "slt"
  },
  "pronunciations": {
    "Oumuamua": "oh moo ah moo ah",
    "'Oumuamua": "oh moo ah moo ah",
    "SETI": "setty"
  },
  "processing": {
    "highpass_hz": 70,
    "deesser": true,
    "compressor": true,
    "target_lufs": -16
