  "voice": "af_heart",
  "speed": 0.96,
  "gap": 0.35,
  "text": "Why didn't you let me in? I was trying to warn you..."
 },
 {
  "id": "vm3b",
  "voice": "af_heart",
  "speed": 0.92,
  "gap": 0.9,
